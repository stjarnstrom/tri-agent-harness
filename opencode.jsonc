{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "harness/AGENT-INSTRUCTIONS.md",
    "CLAUDE.md"
  ],
  "permission": {
    "read": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/credentials.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "bash": {
      "rm -rf /": "deny",
      "sudo *": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
